# ====================================================================
# HireWise AI - Environment Configuration Template
# ====================================================================

# Core Security
SECRET_KEY=hirewise_super_secret_jwt_key_2026_secured_default
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection
# SQLite (default for instant zero-config dev): sqlite:///./hirewise.db
# PostgreSQL (production): postgresql://hirewise_user:hirewise_pass@localhost:5432/hirewise_db
DATABASE_URL=sqlite:///./hirewise.db

# File Upload Configuration
MAX_UPLOAD_SIZE_MB=10

# AI Model Provider
# Options: "offline" (deterministic rule-based & RAG), "gemini", "openai", "anthropic"
AI_PROVIDER=gemini

# Optional API Keys (Leave empty to use deterministic fallback)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Server Ports
BACKEND_PORT=8000
FRONTEND_PORT=5173
